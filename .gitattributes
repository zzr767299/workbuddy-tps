# 统一换行符：源码一律 LF，Windows 脚本用 CRLF
* text=auto eol=lf

*.mjs   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.vbs   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.ico   binary
